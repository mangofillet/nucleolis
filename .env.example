# nucleolus - environment template. Copy to .env and fill in.
# .env is gitignored. Never commit real keys. Keys stay server-side and must
# never appear in logs, API responses or exports (EXECUTION_PLAN.md s3).

# ---------------------------------------------------------------------------
# Data location
# ---------------------------------------------------------------------------
# Where raw caches, normalized files and snapshots live.
# Default is ./data inside the repo (gitignored). Safe with JSON-only storage.
# If you later re-introduce DuckDB, move this OUTSIDE OneDrive (e.g. C:/nod-data)
# because DuckDB and OneDrive file locking do not coexist on Windows.
NOD_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------
# INDRA CoGEx needs no key. Verified reachable 2026-09-12.
COGEX_BASE_URL=https://discovery.indra.bio/api

# NCBI E-utilities: not used in the 3h slice. When enabled, NCBI requires
# tool + email metadata; a key raises the rate limit from 3/sec to 10/sec.
NCBI_TOOL=nucleolus
NCBI_EMAIL=
NCBI_API_KEY=

# ---------------------------------------------------------------------------
# AMASS  <-- PUT YOUR AMASS KEY ON THE LINE BELOW, IN .env (not this file)
# ---------------------------------------------------------------------------
# Optional. NOT required for the first vertical slice and NOT called today.
# Endpoint schema, rights, quotas and per-call cost are unverified, so the
# adapter stays disabled in config/sources.yaml until those are confirmed.
# AMASS credits are a separate budget from LLM usage - set document, token and
# cost ceilings plus resumable checkpoints before any paid run.
AMASS_API_KEY=
AMASS_BASE_URL=

# ---------------------------------------------------------------------------
# LLM sandwich - POST /api/simulate-target
# ---------------------------------------------------------------------------
# Absence of a key must degrade to evidence-only browsing, never to fabrication.
# /ask stays 501, and /graph, /pathways and evidence inspection work with no key
# at all. Keys are only required for live provider calls.
#
# LLM_PROVIDER / LLM_API_KEY / LLM_MODEL were removed: they were scaffold
# leftovers with zero read sites. Settings.from_env() reads the names below.

# The Nebius console shows https://api.tokenfactory.nebius.com/v1/ while
# llm/settings.py still defaults to https://api.studio.nebius.ai/v1/ . Probed
# unauthenticated 2026-09-12: both return 401 and neither redirects, so both
# hosts are live. Set it explicitly to match the console.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# REQUIRED, no default. The model must support strict JSON-schema output
# because llm/nebius.py sends response_format={"type":"json_schema",...}.
NEBIUS_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=65
LLM_PARSER_MAX_TOKENS=1000
LLM_SYNTHESIS_MAX_TOKENS=3000
# Review manifests are authored offline and bound to the snapshot checksum.
NOD_REVIEW_MANIFEST=
NOD_BOOLEAN_MANIFEST=
# Explicit opt-in, with fictional entities and canned providers. Never a live fallback.
NOD_ENABLE_SYNTHETIC_DEMO=false
