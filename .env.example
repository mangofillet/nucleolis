# nucleolis - environment template. Copy to .env and fill in.
# .env is gitignored. Never commit real keys. Keys stay server-side and must
# never appear in logs, API responses or exports (EXECUTION_PLAN.md s3).

# ---------------------------------------------------------------------------
# Data location
# ---------------------------------------------------------------------------
# Where raw caches, normalized files and snapshots live.
# Default is ./data inside the repo (gitignored). Safe with JSON-only storage.
# If you later re-introduce DuckDB, move this OUTSIDE OneDrive (e.g. C:/nod-data)
# because DuckDB and OneDrive file locking do not coexist on Windows.
NOD_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------
# INDRA CoGEx needs no key. Verified reachable 2026-09-12.
COGEX_BASE_URL=https://discovery.indra.bio/api

# NCBI E-utilities: not used in the 3h slice. When enabled, NCBI requires
# tool + email metadata; a key raises the rate limit from 3/sec to 10/sec.
NCBI_TOOL=nucleolis
NCBI_EMAIL=
NCBI_API_KEY=

# ---------------------------------------------------------------------------
# AMASS  <-- PUT YOUR AMASS KEY ON THE LINE BELOW, IN .env (not this file)
# ---------------------------------------------------------------------------
# Optional. NOT required for the first vertical slice and NOT called today.
# Endpoint schema, rights, quotas and per-call cost are unverified, so the
# adapter stays disabled in config/sources.yaml until those are confirmed.
# AMASS credits are a separate budget from LLM usage - set document, token and
# cost ceilings plus resumable checkpoints before any paid run.
AMASS_API_KEY=
AMASS_BASE_URL=https://api.amass.tech/api/v1
# Corroboration is an enrichment channel: it adds provenance and bounded discovery,
# and can never change an edge sign, the graph, Boolean rules or a simulated state.
# Disabled by default. `cached` serves only materialized records; `live` must be
# enabled here before any request can ask for it.
AMASS_ENABLED=false
AMASS_MODE=cached
AMASS_TIMEOUT_SECONDS=15
AMASS_MAX_CALLS_PER_REQUEST=6
AMASS_MAX_SEARCH_RESULTS=20
AMASS_MAX_RECORD_FETCHES=20
AMASS_MAX_CLAIMS=5
# Full text is opt-in per the unresolved licensing boundary; abstracts are preferred.
AMASS_INCLUDE_FULLTEXT=false
# metadata_only reads no passage text, so nothing can be classified as support.
AMASS_CLASSIFIER=metadata_only
# require_approval keeps unreviewed machine classifications out of qualifying support.
NOD_REVIEW_POLICY=require_approval
NOD_ALLOW_PARTIAL_CONTEXT=false
# support ranks displayed paths by the weakest step's publications; belief is the old order.
NOD_PATH_RANKING=support

# ---------------------------------------------------------------------------
# LLM sandwich - POST /api/simulate-target
# ---------------------------------------------------------------------------
# Absence of a key must degrade to evidence-only browsing, never to fabrication.
# /ask and /api/research support common questions without a key.
# /graph, /pathways and evidence inspection also work without credentials.
# at all. Keys are only required for live provider calls.
#
# LLM_PROVIDER / LLM_API_KEY / LLM_MODEL were removed: they were scaffold
# leftovers with zero read sites. Settings.from_env() reads the names below.

# The Nebius console shows https://api.tokenfactory.nebius.com/v1/ while
# llm/settings.py still defaults to https://api.studio.nebius.ai/v1/ . Probed
# unauthenticated 2026-09-12: both return 401 and neither redirects, so both
# hosts are live. Set it explicitly to match the console.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# REQUIRED, no default. The model must support strict JSON-schema output
# because llm/nebius.py sends response_format={"type":"json_schema",...}.
NEBIUS_MODEL=
# Cited research drafts run on Nebius by default with the key and base URL above.
# Empty means drafts use NEBIUS_MODEL; any override must also support strict JSON schema.
NEBIUS_SYNTHESIS_MODEL=
# nebius (default) | anthropic. The two ANTHROPIC_ values are read only when opting in to Claude.
LLM_SYNTHESIS_PROVIDER=nebius
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=65
LLM_PARSER_MAX_TOKENS=1000
LLM_SYNTHESIS_MAX_TOKENS=3000
# Claude only: low | medium | high | xhigh | max. At the model default (high), claude-sonnet-5 can
# spend the whole output budget thinking and return no answer; medium is measured to finish.
LLM_SYNTHESIS_EFFORT=medium
# Review manifests are authored offline and bound to the snapshot checksum.
NOD_REVIEW_MANIFEST=
NOD_BOOLEAN_MANIFEST=
# Explicit opt-in, with fictional entities and canned providers. Never a live fallback.
NOD_ENABLE_SYNTHETIC_DEMO=false
# With no review manifest, analyse unreviewed INDRA evidence as labelled hypotheses.
# Defaults to true when unset; set false to restore the strict review gate.
NOD_ENABLE_EXPLORATORY_MODE=true
